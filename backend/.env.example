# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── NLP Server ───────────────────────────────────────────────
NLP_SERVER_URL=http://localhost:5001

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret

# ─────────────────────────────────────────────────────────────
# FLIGHT APIs (add keys to get real live data)
# Without keys, the bot uses realistic curated estimates
# ─────────────────────────────────────────────────────────────

# Amadeus API — FREE sandbox (best for flights + hotels)
# Sign up free: https://developers.amadeus.com
# Gives: real flight offers, hotel lists
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Aviationstack — FREE tier (1000 req/month)
# Sign up free: https://aviationstack.com
# Gives: live flight status, airline info
AVIATIONSTACK_API_KEY=

# SerpAPI — paid but has trial ($0 for 100 searches)
# https://serpapi.com — use for Google Flights scraping
# Gives: real Google Flights prices
SERPAPI_KEY=

# ─────────────────────────────────────────────────────────────
# HOTEL APIs
# ─────────────────────────────────────────────────────────────

# OpenTripMap — FREE (5000 req/day)
# Sign up free: https://opentripmap.io
# Gives: hotels + attractions + POIs
OPENTRIPMAP_API_KEY=

# Foursquare Places — FREE tier (950 req/day)
# Sign up free: https://developer.foursquare.com
# Gives: hotel names, ratings, locations
FOURSQUARE_API_KEY=

# ─────────────────────────────────────────────────────────────
# MAP (no key needed — uses free OpenStreetMap/OSRM)
# ─────────────────────────────────────────────────────────────
# OSRM public API: http://router.project-osrm.org — FREE, no key
# Leaflet.js map:  completely free, no key needed

# ─────────────────────────────────────────────────────────────
# AI Fallback (optional)
# ─────────────────────────────────────────────────────────────
# Kimi/NVIDIA OpenAI-compatible API
# KIMI_BASE_URL defaults to https://integrate.api.nvidia.com/v1
# KIMI_TEXT_MODEL defaults to moonshotai/kimi-k2-instruct
# KIMI_VISION_MODEL is used for image place recognition
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_TEXT_MODEL=
KIMI_VISION_MODEL=
KIMI_IMAGE_FALLBACK_MODEL=

ANTHROPIC_API_KEY=
